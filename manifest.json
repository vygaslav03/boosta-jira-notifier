{
  "manifest_version": 3,
  "name": "Boosta Jira Notifier",
  "version": "1.0.0",
  "default_locale": "en",
  "description": "Boosta Jira Notifier - Real-time background notifications for Jira mentions, assignments, comments, status changes, and code reviews.",
  "author": "Boosta Engineering Team",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Boosta Jira Notifier"
  },
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "icons/*"],
      "matches": ["https://*.boosta.co/*", "https://*.atlassian.net/*"]
    }
  ]
}
